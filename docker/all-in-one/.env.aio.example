# docker/all-in-one/.env.aio.example — variables d'environnement pour
# l'image unique (api+worker+web+redis interne, docker/all-in-one/
# Dockerfile). À copier en .env.aio (jamais commité) puis :
#   docker run -d --name pgd-app \
#     -p 3000:3000 -p 3001:3001 -p 3002:3002 \
#     --env-file .env.aio pgd-app:latest
#
# Distinct de .env.prod.example (stack docker-compose.prod.yml) : PostgreSQL
# et RabbitMQ ne sont PAS hébergés dans cette image (cf. Dockerfile) — leurs
# URL/hôtes doivent pointer vers de vrais services externes (un autre
# conteneur, une autre machine, un service managé), jamais `localhost`.
# REDIS_URL, en revanche, est fixe : Redis tourne DANS ce même conteneur.

NODE_ENV=production

# --- PostgreSQL — EXTERNE, à fournir (source de vérité, jamais bundlé) ---
DATABASE_URL=postgresql://CHANGER_utilisateur:CHANGER_mot_de_passe@CHANGER_hote_postgres:5432/CHANGER_base?schema=public

# --- Redis — interne à ce conteneur, ne jamais changer ce host/port ------
REDIS_URL=redis://127.0.0.1:6379

# --- RabbitMQ — EXTERNE, à fournir (messages en file, jamais bundlé) -----
RABBITMQ_HOST=CHANGER_hote_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=CHANGER
RABBITMQ_PASSWORD=CHANGER
RABBITMQ_VHOST=/pgd

# --- CORS — URL publique réelle par laquelle le navigateur atteint
# apps/web (le port 3001 de ce même conteneur, derrière un éventuel reverse
# proxy/TLS) — jamais localhost en prod.
CORS_ORIGIN=https://CHANGER_url_publique_web

# --- Session — générer des valeurs DISTINCTES de tout environnement de
# dev/recette : openssl rand -hex 32. Jamais la même valeur qu'ailleurs.
JWT_SECRET=CHANGER_avec_openssl_rand_-hex_32
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGER_avec_openssl_rand_-hex_32
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_COOKIE_NAME=pgd_session
REFRESH_COOKIE_NAME=pgd_refresh
COOKIE_SECURE=true

# --- AUTH_PROVIDER — keycloak ou ad-api (cf. CLAUDE.md « Restauration
# transitoire — AdApiProvider » et « Architecture Keycloak — source
# unique » pour l'arbitrage complet). ⚠️ ad-api ne déclenche aucune étape
# MFA pour aucun rôle — décision à reconfirmer avant tout déploiement réel.
AUTH_PROVIDER=ad-api
AD_API_URL=http://CHANGER_hote_ad_reel:CHANGER_port
AD_API_TIMEOUT_MS=5000

# --- Keycloak — requis même si AUTH_PROVIDER=ad-api (packages/config valide
# le schéma entier au démarrage), sans objet fonctionnellement dans ce cas.
KEYCLOAK_BASE_URL=http://CHANGER_hote_keycloak_reel/keycloak
KEYCLOAK_REALM=DSI-PGD
KEYCLOAK_CLIENT_ID=CHANGER
KEYCLOAK_CLIENT_SECRET=CHANGER
KEYCLOAK_TIMEOUT_MS=60000

# --- Rate limiting anti-bruteforce (SF-PGD-005) ---------------------------
RATE_LIMIT_LOGIN_MAX_TENTATIVES=5
RATE_LIMIT_LOGIN_FENETRE_SECONDES=300
RATE_LIMIT_LOGIN_VERROUILLAGE_SECONDES=900

# --- GedPort (bouchon stockage local, SF-PGD-050) -------------------------
# Chemin DANS ce conteneur — jamais persistant entre recréations sans volume
# monté sur ce chemin précis (docker run -v <hote>:/tmp/pgd-ged).
GED_STORAGE_PATH=/tmp/pgd-ged
GED_MAX_TAILLE_OCTETS=10485760

# --- NEXT_PUBLIC_API_URL — PAS UNE VARIABLE RUNTIME ------------------------
# Rappel (cf. Dockerfile) : cette valeur est inline dans le bundle CLIENT au
# moment du build (`docker build --build-arg NEXT_PUBLIC_API_URL=...`),
# jamais relue ici au lancement du conteneur — l'écrire dans ce fichier
# n'aurait aucun effet.
