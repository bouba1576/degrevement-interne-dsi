{
  "name": "pgd",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme de Gestion des Dégrèvements — Orange Côte d'Ivoire",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @pgd/database exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @pgd/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @pgd/database exec prisma db seed",
    "db:generate": "pnpm --filter @pgd/database exec prisma generate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "qs": "^6.16.0",
      "sharp": "^0.35.4",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "brace-expansion": "^5.0.9",
      "undici": "^7.29.1",
      "fast-uri": "^3.1.7",
      "ip-address": "^10.7.0",
      "hono": "^4.13.7",
      "@hono/node-server": "^1.19.17",
      "browserslist": "^4.28.9",
      "baseline-browser-mapping": "^2.11.21",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2"
    }
  }
}
