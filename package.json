{
  "name": "pgd",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme de Gestion des Dégrèvements — Orange Côte d'Ivoire",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @pgd/database exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @pgd/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @pgd/database exec prisma db seed",
    "db:generate": "pnpm --filter @pgd/database exec prisma generate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
