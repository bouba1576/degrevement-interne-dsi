# ==============================================================
# PGD — variables d'environnement
# Validées par packages/config (Zod) au démarrage de chaque app.
# ==============================================================

NODE_ENV=development

API_PORT=3000
WEB_PORT=3001
WORKER_HEALTH_PORT=3002

# --- apps/web → apps/api (Phase 9.2, premier écran connecté) -----
# NEXT_PUBLIC_* est exposé au bundle client par Next.js — jamais de secret
# ici. Doit correspondre à CORS_ORIGIN côté api (credentials: true) pour que
# les cookies de session soient acceptés cross-origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- PostgreSQL (source de vérité) -------------------------------
DATABASE_URL=postgresql://pgd:pgd@localhost:5432/pgd?schema=public
POSTGRES_USER=pgd
POSTGRES_PASSWORD=pgd
POSTGRES_DB=pgd

# --- Redis (cache config + verrous de claim uniquement) ----------
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (bus de messages — D2, BullMQ écarté) ---------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=pgd
RABBITMQ_PASSWORD=pgd
RABBITMQ_VHOST=/pgd
RABBITMQ_ERLANG_COOKIE=pgd-dev-cookie

# --- CORS ----------------------------------------------------------
CORS_ORIGIN=http://localhost:3001

# --- Session (Phase 2) ---------------------------------------------
# Générer une valeur distincte par variable, localement : openssl rand -hex 32
# Ne jamais copier un exemple committé tel quel, même en dev — secrets réels
# hors dépôt (coffre / variable CI) en recette/prod.
JWT_SECRET=CHANGER_avec_openssl_rand_-hex_32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGER_avec_openssl_rand_-hex_32
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_COOKIE_NAME=pgd_session
REFRESH_COOKIE_NAME=pgd_refresh
COOKIE_SECURE=false

# --- Active Directory (Phase 2, LdapPort réel — SF-PGD-001) --------
# Dev local : conteneur OpenLDAP éphémère (voir apps/api/test/ldap.testcontainer.ts).
# En recette/prod : AD réel Orange CI, LDAPS obligatoire.
LDAP_URL=ldap://localhost:3890
LDAP_BIND_DN=cn=admin,dc=pgd,dc=orange,dc=com
LDAP_BIND_PASSWORD=admin
LDAP_BASE_DN=dc=pgd,dc=orange,dc=com
LDAP_USER_DOMAIN=orange.com

# --- Intégration réelle API AD (AdApiProvider, 19/08/2026) ---------
# LDAP_PROVIDER=ldap (défaut) garde LdapProvider (annuaire dev OpenLDAP
# ci-dessus) — laisser tel quel en dev. "ad-api" bascule vers l'API AD REST
# réelle (AD_API_URL alors requis) — cf. CLAUDE.md « identifiantAd = username
# brut », révérification depuis le réseau interne encore à faire.
LDAP_PROVIDER=ldap
# AD_API_URL=http://192.168.31.78:8080
AD_API_TIMEOUT_MS=5000

# --- MFA (Phase 2, MfaPort réel — SF-PGD-002, ADR-08) --------------
# DUO : aucun tenant Duo réel disponible dans cet environnement de dev — ces
# valeurs sont des PLACEHOLDERS NON FONCTIONNELS. DuoProvider échouera à tout
# appel réel tant qu'un vrai DUO_CLIENT_ID/SECRET/API_HOST n'est pas fourni.
# Utiliser un compte de test avec mfa_methode=TOTP pour la démonstration.
DUO_CLIENT_ID=PLACEHOLDER_NON_FONCTIONNEL
DUO_CLIENT_SECRET=PLACEHOLDER_NON_FONCTIONNEL
DUO_API_HOST=api-placeholder.duosecurity.com
DUO_REDIRECT_URI=http://localhost:3000/api/auth/mfa/duo/callback

TOTP_ISSUER=PGD Orange CI
# 32 octets en hexadécimal (64 caractères) — openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CHANGER_avec_openssl_rand_-hex_32

# --- Rate limiting anti-bruteforce (Phase 2, SF-PGD-005) -----------
RATE_LIMIT_LOGIN_MAX_TENTATIVES=5
RATE_LIMIT_LOGIN_FENETRE_SECONDES=300
RATE_LIMIT_LOGIN_VERROUILLAGE_SECONDES=900

# --- GedPort (Phase 4, bouchon stockage local, SF-PGD-050) ---------
GED_STORAGE_PATH=/tmp/pgd-ged
GED_MAX_TAILLE_OCTETS=10485760

# --- Claim double verrou (Phase 6, SF-PGD-072) ---------------------
TACHE_VERROU_TTL_SECONDES=1800

# ==============================================================
# Phases suivantes — non validées tant que le module correspondant
# n'existe pas. Section conservée pour l'exhaustivité de ce fichier
# (PGD-002) mais ne pas ajouter au schéma Zod avant la phase concernée.
# ==============================================================

# Phase 3/7 — Ports d'intégration (bouchons commutables)
# CRM_PROVIDER=stub
# JADE_PROVIDER=stub
# GED_PROVIDER=stub
# SMTP_PROVIDER=stub
# BILLING_SI_PROVIDER=stub
