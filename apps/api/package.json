{
  "name": "@pgd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --testMatch \"**/test/**/*.e2e-spec.ts\"",
    "openapi:export": "ts-node --compiler-options {\"module\":\"commonjs\"} scripts/export-openapi.ts"
  },
  "dependencies": {
    "@duosecurity/duo_universal": "^2.0.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@pgd/config": "workspace:*",
    "@pgd/contracts": "workspace:*",
    "@pgd/database": "workspace:*",
    "@pgd/messaging": "workspace:*",
    "amqplib": "^0.10.4",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/amqplib": "^0.10.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/pdfkit": "^0.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
