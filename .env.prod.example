# ==============================================================
# PGD — variables d'environnement de PRODUCTION/RECETTE
# À copier en .env.prod (jamais commité) puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Sur le modèle de .env.example (dev) — mêmes noms de variables, validées
# par le même schéma Zod (packages/config) au démarrage de chaque app.
# Différences volontaires : aucune valeur par défaut fonctionnelle sur les
# secrets/URLs (docker-compose.prod.yml échoue explicitement si l'une des
# variables marquées ci-dessous est absente, plutôt que de démarrer avec
# une valeur de dev par erreur), COOKIE_SECURE=true par défaut.
# ==============================================================

NODE_ENV=production

API_PORT=3000
WEB_PORT=3001
WORKER_HEALTH_PORT=3002

# --- Variables lues par docker-compose.prod.yml UNIQUEMENT ---------
# Jamais lues par l'application elle-même (absentes de packages/config) —
# elles pilotent seulement quelle image est tirée par `docker compose`.
# DOCKER_REGISTRY : registre où sont poussées les images pgd-api/pgd-worker/
# pgd-web (Nexus interne, non confirmé dans ce dépôt — cf. CLAUDE.md,
# section « Sécurité — vulnérabilités CRITICAL des images Docker », question
# ouverte sur le pipeline réel qui construit et pousse ces images).
DOCKER_REGISTRY=CHANGER_registre_nexus_interne
IMAGE_TAG=latest

# --- apps/web → apps/api -------------------------------------------
# LIMITE CONNUE (cf. commentaire en tête de docker-compose.prod.yml) :
# inlinée dans le bundle client par Next.js AU BUILD de l'image, jamais relue
# à l'exécution du conteneur — la renseigner ici seule ne suffit PAS tant que
# apps/web/Dockerfile ne déclare pas l'ARG correspondant. Conservée ici pour
# mémoire et pour le jour où le Dockerfile sera corrigé.
NEXT_PUBLIC_API_URL=https://CHANGER_url_publique_api

# --- PostgreSQL (source de vérité) — hébergement externe, non confirmé ---
# Aucun service Postgres auto-hébergé dans docker-compose.prod.yml : à
# renseigner vers l'instance réelle (managée ou auto-hébergée séparément)
# une fois cette décision prise.
DATABASE_URL=postgresql://CHANGER_utilisateur:CHANGER_mot_de_passe@CHANGER_hote:5432/CHANGER_base?schema=public

# --- Redis (cache config + verrous de claim uniquement) — externe --------
REDIS_URL=redis://CHANGER_hote:6379

# --- RabbitMQ (bus de messages) — externe ---------------------------------
RABBITMQ_HOST=CHANGER_hote
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=CHANGER
RABBITMQ_PASSWORD=CHANGER
RABBITMQ_VHOST=/pgd

# --- CORS ------------------------------------------------------------------
# URL publique réelle de apps/web — jamais localhost en prod (credentials:
# true côté api, cf. main.ts, exige une origine exacte).
CORS_ORIGIN=https://CHANGER_url_publique_web

# --- Session -----------------------------------------------------------
# Générer une valeur DISTINCTE de tout environnement de dev/recette :
# openssl rand -hex 32
# Jamais la même valeur qu'un .env de dev, jamais copiée d'un exemple.
JWT_SECRET=CHANGER_avec_openssl_rand_-hex_32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGER_avec_openssl_rand_-hex_32
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_COOKIE_NAME=pgd_session
REFRESH_COOKIE_NAME=pgd_refresh
COOKIE_SECURE=true

# --- Active Directory (LdapPort réel — SF-PGD-001) ----------------------
# AD réel Orange CI. LDAPS attendu en prod (contrairement au ldap:// non
# chiffré du conteneur openldap de dev) — cf. CLAUDE.md, section « API AD
# réelle » : l'API réelle communiquée à ce jour est en réalité un endpoint
# REST (POST .../authenticate), pas un bind LDAP classique — vérifier que
# LdapProvider est bien le bon adaptateur pour ce qui sera réellement
# déployé avant de renseigner ces valeurs telles quelles.
LDAP_URL=ldaps://CHANGER_ad_reel_orange_ci
LDAP_BIND_DN=CHANGER
LDAP_BIND_PASSWORD=CHANGER
LDAP_BASE_DN=CHANGER
LDAP_USER_DOMAIN=orange.ci

# --- MFA (MfaPort réel — SF-PGD-002, ADR-08) ----------------------------
# DUO : tenant Duo réel requis en production — contrairement aux placeholders
# non fonctionnels de .env.example (dev). Cf. CLAUDE.md, section
# « Déploiement V1 — bascule MFA d'urgence » : si DUO n'est pas encore
# disponible au moment du déploiement, la bascule mfaMethode=TOTP documentée
# là-bas reste la mesure temporaire en vigueur, indépendante de ces valeurs.
DUO_CLIENT_ID=CHANGER
DUO_CLIENT_SECRET=CHANGER
DUO_API_HOST=CHANGER
DUO_REDIRECT_URI=https://CHANGER_url_publique_api/api/auth/mfa/duo/callback

TOTP_ISSUER=PGD Orange CI
# 32 octets en hexadécimal (64 caractères) — openssl rand -hex 32
# Distincte de toute clé de dev/recette : une clé partagée entre
# environnements permettrait de déchiffrer les secrets TOTP d'un autre
# environnement en cas de fuite de base.
TOTP_ENCRYPTION_KEY=CHANGER_avec_openssl_rand_-hex_32

# --- Rate limiting anti-bruteforce (SF-PGD-005) -------------------------
RATE_LIMIT_LOGIN_MAX_TENTATIVES=5
RATE_LIMIT_LOGIN_FENETRE_SECONDES=300
RATE_LIMIT_LOGIN_VERROUILLAGE_SECONDES=900

# --- GedPort (bouchon stockage local, SF-PGD-050) -----------------------
# Toujours un bouchon (stockage disque local) à ce jour — cf. CLAUDE.md,
# « Ports d'intégration ». Un chemin sur le disque du conteneur n'est pas
# persistant entre redéploiements tant qu'aucun volume n'est monté ici :
# accepté tel quel pour l'instant, cohérent avec le statut de bouchon.
GED_STORAGE_PATH=/tmp/pgd-ged
GED_MAX_TAILLE_OCTETS=10485760

# --- Claim double verrou (SF-PGD-072) -----------------------------------
TACHE_VERROU_TTL_SECONDES=1800

# ==============================================================
# Phases suivantes — non validées tant que le module correspondant
# n'existe pas (identique à .env.example). Ne pas renseigner : ces
# variables ne sont lues par aucun schéma Zod aujourd'hui (cf. CLAUDE.md,
# « Envoi d'e-mail réel — état vérifié » pour SMTP en particulier — aucun
# SMTP_PROVIDER n'est réellement lu, SmtpStubAdapter reste câblé en dur).
# ==============================================================

# CRM_PROVIDER=stub
# JADE_PROVIDER=stub
# GED_PROVIDER=stub
# SMTP_PROVIDER=stub
# BILLING_SI_PROVIDER=stub
