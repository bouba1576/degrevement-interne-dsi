node_modules/
.pnpm-store/
dist/
.next/
coverage/
*.log
.env
.env.local
# Trouvé absent le 18/08/2026 (rédaction du guide de déploiement prod) :
# seuls .env/.env.local étaient exclus — .env.prod (et tout futur .env.*)
# aurait pu être committé par erreur, même classe de faille que l'incident
# .dockerignore déjà documenté dans CLAUDE.md. Motif générique + exceptions
# explicites sur les fichiers d'exemple, jamais l'inverse.
.env.*
!.env.example
!.env.prod.example
.turbo/
*.tsbuildinfo
.DS_Store
packages/database/prisma/generated/
.claude/settings.local.json
# Même discipline que .env.* ci-dessus : apps/api/scripts/enrolement-comptes.ts
# lit un fichier JSON contenant des identifiants AD réels — jamais destiné à
# être commité, contrairement à exemple-comptes.json (données fictives).
apps/api/scripts/*.json
!apps/api/scripts/exemple-comptes.json
